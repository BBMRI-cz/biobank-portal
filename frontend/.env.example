# Copy to .env.local and fill in. .env.local is git-ignored.
# Only variables prefixed with VITE_ are exposed to the app (and end up in the
# built bundle, so never put secrets here).
#
# Everything else (e.g. OIDC settings) is fetched from the backend at startup:
# GET ${VITE_API_BASE_URL}/config

# Base URL of the backend REST API
VITE_API_BASE_URL=http://localhost:8080/api
