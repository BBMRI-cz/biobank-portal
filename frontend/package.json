{
  "name": "biobank-portal-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test": "vitest run",
    "build-only": "vite build",
    "type-check": "tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . && eslint .",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check --experimental-cli src/"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@tsconfig/node24": "^24.0.6",
    "@tsconfig/strictest": "^2.0.9",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.95.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.1.0",
    "oxlint": "^1.95.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
